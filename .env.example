# API Keys - Copy this to .env and fill in your values
# =============================================

# Twilio (Phone calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# OpenAI (Whisper STT)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic / AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION_NAME=ap-south-1
ANTHROPIC_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your_elevenlabs-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/voice_booker

# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# App Config
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true